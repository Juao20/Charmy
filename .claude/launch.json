{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "charmy-backend/venv/Scripts/python.exe",
      "runtimeArgs": ["charmy-backend/manage.py", "runserver", "0.0.0.0:8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "charmy-frontend", "run", "dev", "--", "--host"],
      "port": 5173,
      "autoPort": true
    }
  ]
}
